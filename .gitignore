.venv/
.pip-cache/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

rsna_knee_dicom_mini*.zip
rsna_knee_dicom_mini*/
*.dcm

# Derived artefacts: always regenerable, never versioned.
data/processed/
kaggle/datasets/labels/report_labels_blend.csv

# Real DICOMs: competition data, not redistributable (rules 2.4.b).
data/raw/test_series
data/raw/train_series

# Generated inspection output. Only the weights are excluded — they are 5.4 GB against
# 7.2 MB for everything else, and they are reproducible from the run that made them.
out/**/*.pt

# Third-party encoder weights: refetched with one line, not versioned.
models/

# Pathology atlas pages. The builder is in git; its output is not — each page embeds
# a few hundred patient MRI slices as data URIs, and this repo has a GitHub remote.
docs/atlas/*.html

# And the measurement one of those builders caches beside its page, so a rerun does not
# re-read 292 studies. Derived from the DICOM, not from anything a reader wrote.
docs/atlas/*.npz

# Annotation exports land here from the browser's download directory. The copy that
# counts is in data/manual_annotations/, named after who made it and when. The tool now
# names the file after the point it collected, so this matches any of them rather than
# only the first one's spelling.
/landmarks-*.json

# Experiment configs, by request. They stay on disk and remain the provenance of every
# row in docs/experiments.md — a row names a commit, and the config beside it says which
# box, which label table, which gold policy ran. Out of the repo by choice, not because
# they are derived: no rerun regenerates them, so do not delete the directory.
#
# Only the JSON. `experiments/` is an imported package — `scripts/train.py` and
# `tests/smoke.py` both do `import experiments` — so `__init__.py` stays tracked, and so
# do the 700 lines of README and RESULTS beside it.
experiments/*.json

# Personal notes, not project record.
/trucs_à_faire.txt
